<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="800" height="500">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1c1008" />
      <stop offset="50%" stop-color="#09090b" />
      <stop offset="100%" stop-color="#2a0a0a" />
    </linearGradient>
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#f59e0b" />
      <stop offset="50%" stop-color="#fde047" />
      <stop offset="100%" stop-color="#ea580c" />
    </linearGradient>
    <linearGradient id="gelPack" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#f59e0b" />
      <stop offset="100%" stop-color="#b45309" />
    </linearGradient>
    <linearGradient id="bcaaBox" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#dc2626" />
      <stop offset="100%" stop-color="#7f1d1d" />
    </linearGradient>
    <linearGradient id="capBottle" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#0284c7" />
      <stop offset="100%" stop-color="#1e3a8a" />
    </linearGradient>
  </defs>
  <rect width="800" height="500" rx="28" fill="url(#bgGrad)" stroke="#f59e0b" stroke-width="4" />
  <circle cx="680" cy="100" r="180" fill="#f59e0b" opacity="0.08" />
  <circle cx="120" cy="420" r="160" fill="#ef4444" opacity="0.08" />

  <!-- 頂部聯名標章 -->
  <rect x="40" y="32" width="380" height="36" rx="18" fill="#f59e0b" />
  <text x="230" y="56" font-family="Arial, sans-serif" font-size="16" font-weight="900" fill="#000000" text-anchor="middle">GLOBAL 100 × aminoMax 邁克仕官方聯名活動</text>

  <text x="40" y="115" font-family="Arial, sans-serif" font-size="38" font-weight="900" fill="#ffffff">預先勾選參賽場次・免費領取能量補給！</text>
  <text x="40" y="152" font-family="Arial, sans-serif" font-size="20" font-weight="700" fill="#fbbf24">開賽前 30 天登入百鐵會員勾選 ➔ 現場憑「號碼布」或「安全帽號碼貼」做記號即刻領取</text>

  <!-- 三款邁克仕主力產品視覺模型 -->
  <!-- 產品 1：能量膠 -->
  <g transform="translate(55, 185)">
    <rect x="0" y="20" width="140" height="210" rx="18" fill="url(#gelPack)" stroke="#fde047" stroke-width="3" />
    <rect x="45" y="0" width="50" height="24" rx="6" fill="#fde047" />
    <text x="70" y="75" font-family="Arial, sans-serif" font-size="22" font-weight="900" fill="#ffffff" text-anchor="middle">aminoMax</text>
    <text x="70" y="110" font-family="Arial, sans-serif" font-size="26" font-weight="900" fill="#000000" text-anchor="middle">能量膠</text>
    <text x="70" y="140" font-family="Arial, sans-serif" font-size="14" font-weight="800" fill="#fffbeb" text-anchor="middle">ENERGY GEL</text>
    <rect x="20" y="165" width="100" height="32" rx="8" fill="#000000" opacity="0.7" />
    <text x="70" y="186" font-family="Arial, sans-serif" font-size="14" font-weight="800" fill="#fde047" text-anchor="middle">瞬效耐力補給</text>
  </g>

  <!-- 產品 2：BCAA 晶沛胺基酸 -->
  <g transform="translate(230, 175)">
    <rect x="0" y="15" width="165" height="225" rx="20" fill="url(#bcaaBox)" stroke="#fca5a5" stroke-width="3" />
    <text x="82" y="65" font-family="Arial, sans-serif" font-size="24" font-weight="900" fill="#fde047" text-anchor="middle">aminoMax</text>
    <text x="82" y="105" font-family="Arial, sans-serif" font-size="30" font-weight="900" fill="#ffffff" text-anchor="middle">BCAA 8000</text>
    <text x="82" y="138" font-family="Arial, sans-serif" font-size="18" font-weight="800" fill="#fecaca" text-anchor="middle">頂級晶沛胺基酸</text>
    <rect x="22" y="165" width="120" height="36" rx="10" fill="#000000" opacity="0.65" />
    <text x="82" y="188" font-family="Arial, sans-serif" font-size="15" font-weight="800" fill="#4ade80" text-anchor="middle">延緩疲勞・強效恢復</text>
  </g>

  <!-- 產品 3：電解質膠囊 -->
  <g transform="translate(430, 190)">
    <rect x="0" y="20" width="135" height="205" rx="22" fill="url(#capBottle)" stroke="#7dd3fc" stroke-width="3" />
    <rect x="32" y="0" width="70" height="24" rx="6" fill="#e0f2fe" />
    <text x="67" y="75" font-family="Arial, sans-serif" font-size="20" font-weight="900" fill="#38bdf8" text-anchor="middle">aminoMax</text>
    <text x="67" y="110" font-family="Arial, sans-serif" font-size="22" font-weight="900" fill="#ffffff" text-anchor="middle">電解質膠囊</text>
    <text x="67" y="138" font-family="Arial, sans-serif" font-size="13" font-weight="700" fill="#bae6fd" text-anchor="middle">ELECTROLYTE+</text>
    <rect x="18" y="162" width="100" height="32" rx="8" fill="#000000" opacity="0.65" />
    <text x="67" y="183" font-family="Arial, sans-serif" font-size="14" font-weight="800" fill="#38bdf8" text-anchor="middle">長距離防抽筋</text>
  </g>

  <!-- 右側現場核銷圖示說明 -->
  <g transform="translate(595, 185)">
    <rect x="0" y="0" width="170" height="225" rx="20" fill="#18181b" stroke="#f59e0b" stroke-width="2" />
    <text x="85" y="40" font-family="Arial, sans-serif" font-size="18" font-weight="900" fill="#f59e0b" text-anchor="middle">🎫 現場核銷方式</text>
    <rect x="20" y="58" width="130" height="62" rx="10" fill="#27272a" />
    <text x="85" y="83" font-family="Arial, sans-serif" font-size="15" font-weight="900" fill="#ffffff" text-anchor="middle">1. 鐵人賽號碼布</text>
    <text x="85" y="106" font-family="Arial, sans-serif" font-size="12" font-weight="700" fill="#a1a1aa" text-anchor="middle">工作人員註記蓋章</text>
    <rect x="20" y="135" width="130" height="68" rx="10" fill="#27272a" />
    <text x="85" y="160" font-family="Arial, sans-serif" font-size="15" font-weight="900" fill="#38bdf8" text-anchor="middle">2. 安全帽號碼貼</text>
    <text x="85" y="183" font-family="Arial, sans-serif" font-size="12" font-weight="700" fill="#a1a1aa" text-anchor="middle">無號碼布單車賽適用</text>
  </g>

  <!-- 底部標語 -->
  <text x="400" y="465" font-family="Arial, sans-serif" font-size="17" font-weight="800" fill="#e4e4e7" text-anchor="middle">
    🛡️ 醫護鐵人 IRONMEDIC 創立統籌 × 全球百鐵認證 G100TC 年度指定合作補給
  </text>
</svg>